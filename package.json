      "sass": "./src/entries/avatar.scss"
    },
    "./avatar-group": {
      "sass": "./src/entries/avatar-group.scss"
    },
    "./card": {
      "sass": "./src/entries/card.scss"
    },
    "./panel": {
      "sass": "./src/entries/panel.scss"
    },
    "./alert": {
      "sass": "./src/entries/alert.scss"
    },
    "./empty-state": {
      "sass": "./src/entries/empty-state.scss"
    },
    "./stat": {
      "sass": "./src/entries/stat.scss"
    },
    "./desc-list": {
      "sass": "./src/entries/desc-list.scss"
    },
    "./info-row": {
      "sass": "./src/entries/info-row.scss"
    },
    "./list": {
      "sass": "./src/entries/list.scss"
    },
    "./timeline": {
      "sass": "./src/entries/timeline.scss"
    },
    "./title": {
      "sass": "./src/entries/title.scss"
    },
    "./text": {
      "sass": "./src/entries/text.scss"
    },
    "./code-block": {
      "sass": "./src/entries/code-block.scss"
    },
    "./breadcrumb": {
      "sass": "./src/entries/breadcrumb.scss"
    },
    "./pagination": {
      "sass": "./src/entries/pagination.scss"
    },
    "./page-header": {
      "sass": "./src/entries/page-header.scss"
    },
    "./toolbar": {
