    "./js": "./dist/wovenui-kit.js",
    "./components.json": "./dist/components.json",
    "./llms-full.txt": "./dist/llms-full.txt",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "stylelint \"src/**/*.scss\"",
    "format": "prettier --write \"src/**/*.scss\" \"src/js/**/*.js\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.scss\" \"src/js/**/*.js\" \"scripts/**/*.mjs\"",
    "build:scss": "node --conditions=sass scripts/build-scss.mjs src/index.scss dist/wovenui-kit.css",
    "build:minify": "postcss dist/wovenui-kit.css -o dist/wovenui-kit.min.css --use cssnano --map",
    "build": "pnpm run build:scss && pnpm run build:minify && pnpm run build:js && pnpm run build:docs",
    "dev": "node --conditions=sass --watch-path=src scripts/build-scss.mjs src/index.scss dist/wovenui-kit.css",
    "check": "node scripts/check-modifiers.mjs",
    "test": "pnpm run build && node --conditions=sass test/compile.mjs && node --conditions=sass test/switches.mjs && node --conditions=sass test/entries.mjs && node --conditions=sass test/caret.mjs && node test/modifiers.mjs && node test/size.mjs && node test/js.mjs && node --conditions=sass test/docs.mjs",
    "build:js": "node scripts/build-js.mjs",
    "build:docs": "node scripts/build-docs.mjs"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@wovenui/core": "^2.2.2",
    "cssnano": "^8.0.10",
    "postcss": "^8.5.28",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "peerDependencies": {
    "@wovenui/core": "^2.2.2",
    "sass": ">=1.79.0 <2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
