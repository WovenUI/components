{
  "name": "@wovenui/components",
  "version": "1.0.0",
  "description": "WovenUI Components (UI kit): components built on @wovenui/core tokens. CSS, plus a small optional script.",
  "author": {
    "name": "AALA IT Solutions",
    "url": "https://aalasolutions.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://wovenui.com/components/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WovenUI/components.git"
  },
  "bugs": {
    "url": "https://github.com/WovenUI/components/issues"
  },
  "main": "dist/wovenui-kit.min.css",
  "style": "dist/wovenui-kit.min.css",
  "sass": "src/index.scss",
  "keywords": [
    "wovenui",
    "css",
    "html",
    "components",
    "ui-components",
    "ui-kit",
    "design-system",
    "css-components",
    "sass",
    "accessible",
    "native-html",
    "dialog",
    "popover",
    "rtl",
    "dark-mode",
    "themes",
    "css-only-components",
    "css-framework",
    "ui-library",
    "component-library",
    "html-css",
    "bootstrap-alternative",
    "modal",
    "dropdown",
    "tabs",
    "toast",
    "accordion",
    "data-table",
    "anchor-positioning",
    "invoker-commands",
    "logical-properties",
    "wovenui-core"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "sass": "./src/index.scss",
      "style": "./dist/wovenui-kit.min.css",
      "default": "./dist/wovenui-kit.min.css"
    },
    "./scss": "./src/index.scss",
    "./css": "./dist/wovenui-kit.css",
    "./min.css": "./dist/wovenui-kit.min.css",
