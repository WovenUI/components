    },
    "./sidebar": {
      "sass": "./src/entries/sidebar.scss"
    },
    "./table": {
      "sass": "./src/entries/table.scss"
    },
    "./progress": {
      "sass": "./src/entries/progress.scss"
    },
    "./progress-circle": {
      "sass": "./src/entries/progress-circle.scss"
    },
    "./skeleton": {
      "sass": "./src/entries/skeleton.scss"
    },
    "./field": {
      "sass": "./src/entries/field.scss"
    },
    "./field-group": {
      "sass": "./src/entries/field-group.scss"
    },
    "./field-message": {
      "sass": "./src/entries/field-message.scss"
    },
    "./form-actions": {
      "sass": "./src/entries/form-actions.scss"
    },
    "./input": {
      "sass": "./src/entries/input.scss"
    },
    "./input-group": {
      "sass": "./src/entries/input-group.scss"
    },
    "./textarea": {
      "sass": "./src/entries/textarea.scss"
    },
    "./select": {
      "sass": "./src/entries/select.scss"
    },
    "./checkbox": {
      "sass": "./src/entries/checkbox.scss"
    },
    "./radio": {
      "sass": "./src/entries/radio.scss"
    },
    "./toggle": {
      "sass": "./src/entries/toggle.scss"
    },
    "./segmented": {
      "sass": "./src/entries/segmented.scss"
    },
    "./accordion": {
      "sass": "./src/entries/accordion.scss"
    },
    "./modal": {
      "sass": "./src/entries/modal.scss"
    },
    "./confirm-modal": {
      "sass": "./src/entries/confirm-modal.scss"
    },
    "./drawer": {
      "sass": "./src/entries/drawer.scss"
    },
